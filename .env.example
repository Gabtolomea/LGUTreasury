# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values:
#     Copy-Item .env.example .env
# Keys map to ASP.NET Core configuration (use __ for hierarchy).
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# Native .NET development database connection (required when running with dotnet run)
# SslMode=Required forces TLS to MySQL, so the password never travels in the clear
# and MySQL 8's caching_sha2_password plugin works without AllowPublicKeyRetrieval.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=LGUTreasury;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SslMode=Required;

# Docker app connecting to MySQL running on the host machine
NATIVE_MYSQL_CONNECTION=Server=host.docker.internal;Port=3306;Database=LGUTreasury;User=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;SslMode=Required;

# Docker Compose database settings
# Compose uses these values for the MySQL container and overrides the app's
# connection string to use the internal hostname `db`.
MYSQL_DATABASE=LGU_Treasury_DB
MYSQL_USER=lgu_user
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
