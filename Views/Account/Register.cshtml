@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register — LGU Revenue Record System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="auth-left">
        <img src="~/images/lgu.png" alt="LGU Logo" onerror="this.style.display='none'" />
        <div class="auth-left-title"><span>LGU</span> Revenue<br />Record System</div>
        <div class="auth-left-desc">Secure, efficient revenue collection management for Local Government Units. Track payments, generate reports, and maintain full audit trails.</div>
        <div class="auth-left-footer">Republic of the Philippines &nbsp;·&nbsp; Local Government Unit of Ginatilan</div>
    </div>

    <div class="auth-right login-bg">
        <div class="auth-card register-card-wrap">
            <div class="auth-card-header">
                <div class="auth-card-label">Municipality of Ginatilan</div>
                <div class="auth-card-title">Create Account</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-error">Please correct the highlighted fields below.</div>
            }

            <form asp-action="Register" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="auth-form-grid">
                    <!-- Account Credentials -->
                    <div class="form-section-label">Account Credentials</div>

                    <div class="auth-form-group auth-span-full">
                        <label class="form-label" for="EmployeeID">ID Number</label>
                        <input asp-for="EmployeeID" class="form-input" placeholder="Enter your assigned ID" autocomplete="username" required />
                        <span asp-validation-for="EmployeeID" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="Password">Password</label>
                        <div class="password-wrap">
                            <input type="password" class="form-input" id="Password" name="Password" placeholder="Create a password" autocomplete="new-password" required />
                            <button type="button" class="password-toggle" data-target="Password" aria-label="Show password">
                                <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="ConfirmPassword">Confirm Password</label>
                        <div class="password-wrap">
                            <input type="password" class="form-input" id="ConfirmPassword" name="ConfirmPassword" placeholder="Re-enter your password" autocomplete="new-password" required />
                            <button type="button" class="password-toggle" data-target="ConfirmPassword" aria-label="Show password">
                                <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                        <span class="field-hint" id="passwordMatchHint"></span>
                    </div>

                    <!-- Personal Information -->
                    <div class="form-section-label">Personal Information</div>

                    <div class="auth-form-group">
                        <label class="form-label" for="FirstName">First Name</label>
                        <input asp-for="FirstName" class="form-input" placeholder="e.g. Juan" autocomplete="given-name" required />
                        <span asp-validation-for="FirstName" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="LastName">Last Name</label>
                        <input asp-for="LastName" class="form-input" placeholder="e.g. Cruz" autocomplete="family-name" required />
                        <span asp-validation-for="LastName" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="MiddleName">Middle Name</label>
                        <input asp-for="MiddleName" class="form-input" placeholder="Optional" autocomplete="additional-name" />
                        <span asp-validation-for="MiddleName" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="Suffix">Suffix</label>
                        <input asp-for="Suffix" class="form-input" placeholder="Sr., Jr., III…" />
                        <span asp-validation-for="Suffix" class="field-error"></span>
                    </div>

                    <!-- Contact Details -->
                    <div class="form-section-label">Contact Details</div>

                    <div class="auth-form-group">
                        <label class="form-label" for="Email">Email Address</label>
                        <input asp-for="Email" class="form-input" placeholder="Optional" autocomplete="email" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="auth-form-group">
                        <label class="form-label" for="ContactNumber">Contact No.</label>
                        <input asp-for="ContactNumber" type="tel" inputmode="numeric" class="form-input" placeholder="09XX-XXX-XXXX" autocomplete="tel" maxlength="20" data-contact-number />
                        <span asp-validation-for="ContactNumber" class="field-error"></span>
                    </div>

                    <div class="auth-form-group auth-span-full">
                        <label class="form-label" for="Address">Address</label>
                        <input asp-for="Address" class="form-input" placeholder="Complete address" autocomplete="street-address" />
                        <span asp-validation-for="Address" class="field-error"></span>
                    </div>
                </div>

                <div class="alert alert-info" style="margin-top:16px">
                    Your account role will be assigned by the administrator after registration.
                </div>

                <button type="submit" class="btn-primary">CREATE ACCOUNT</button>
            </form>

            <div class="auth-switch-link" style="margin-top:14px">
                Already have an account? <a asp-action="Login" asp-controller="Account">Sign in here</a>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <script src="~/js/contact-number.js"></script>
    <script src="~/js/auth.js"></script>
</body>
</html>
