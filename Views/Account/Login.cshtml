@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — LGU Revenue Record System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="auth-left">
        <img src="~/images/lgu.png" alt="LGU Logo" onerror="this.style.display='none'" />
        <div class="auth-left-title"><span>LGU</span> Revenue<br />Record System</div>
        <div class="auth-left-desc">Secure, efficient revenue collection management for Local Government Units. Track payments, generate reports, and maintain full audit trails.</div>
        <div class="auth-left-footer">Republic of the Philippines &nbsp;·&nbsp; Local Government Unit of Ginatilan</div>
    </div>

    <div class="auth-right login-bg">
        <div class="auth-card login-card-wrap">
            <div class="auth-card-header">
                <div class="auth-card-label">Municipality of Ginatilan</div>
                <div class="auth-card-title">Welcome Back!</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">@TempData["Error"]</div>
            }
            else if (!ViewData.ModelState.IsValid)
            {
                var messages = new List<string>();
                foreach (var state in ViewData.ModelState.Values)
                {
                    foreach (var error in state.Errors)
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                            messages.Add(error.ErrorMessage);
                    }
                }
                if (messages.Count > 0)
                {
                    <div class="alert alert-error">
                        @foreach (var msg in messages)
                        {
                            <div>@msg</div>
                        }
                    </div>
                }
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div class="auth-form-group" style="margin-bottom:14px">
                    <label class="form-label" for="EmployeeID">ID Number</label>
                    <input asp-for="EmployeeID" class="form-input" placeholder="Enter your ID number" autocomplete="username" required />
                    <span asp-validation-for="EmployeeID" class="field-error"></span>
                </div>
                <div class="auth-form-group" style="margin-bottom:4px">
                    <label class="form-label" for="Password">Password</label>
                    <div class="password-wrap">
                        <input type="password" class="form-input" id="Password" name="Password" placeholder="Enter your password" autocomplete="current-password" required />
                        <button type="button" class="password-toggle" data-target="Password" aria-label="Show password">
                            <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <a class="forgot-link" href="@Url.Action("Index", "ForgotPassword")">Forgot password?</a>
                <button type="submit" class="btn-primary" style="margin-top:18px">SIGN IN</button>
            </form>

            <div class="auth-switch-link">
                Don't have an account? <a asp-action="Register" asp-controller="Account">Register here</a>
            </div>
            <div class="auth-card-footer">Sign in with your assigned credentials</div>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <script src="~/js/auth.js"></script>
</body>
</html>
