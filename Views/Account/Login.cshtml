@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — LGU Revenue Record System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; font-family: 'Inter', sans-serif; }
        :root {
            --green: #388E3C; --green-dark: #2E7D32; --green-light: #C8E6C9;
            --gray-input: #ebebeb; --gray-border: #E0E0E0;
            --text: #1a1a1a; --text-2: #444; --text-3: #888;
            --red: #c0392b; --shadow: 0 2px 12px rgba(0,0,0,.08);
        }
        body { display: flex; min-height: 100vh; }
        .form-label { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); margin-bottom: 6px; display: block; }
        .form-input { width: 100%; padding: 12px 14px; background: var(--gray-input); border: 1.5px solid transparent; border-radius: 8px; font-size: 14px; font-family: 'Inter', sans-serif; color: var(--text); transition: border-color .2s, background .2s; outline: none; }
        .form-input:focus { border-color: #388E3C; background: white; }
        .btn-primary { width: 100%; padding: 14px; background: #388E3C; color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; transition: background .2s; letter-spacing: .04em; }
        .btn-primary:hover { background: #2E7D32; }
        .toast { position: fixed; bottom: 24px; right: 24px; background: #2E7D32; color: white; padding: 12px 20px; border-radius: 10px; font-size: 13.5px; font-weight: 600; box-shadow: var(--shadow); z-index: 999; transform: translateY(80px); opacity: 0; transition: transform .3s, opacity .3s; }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast.error { background: var(--red); }
    </style>
</head>
<body>
    <div class="auth-left" style="width:42%">
        <img src="~/images/lgu.png" alt="LGU Logo" onerror="this.style.display='none'" />
        <div class="auth-left-title"><span>LGU</span> Revenue<br>Record System</div>
        <div class="auth-left-desc">Secure, efficient revenue collection management for Local Government Units. Track payments, generate reports, and maintain full audit trails.</div>
        <div class="auth-left-footer">Republic of the Philippines &nbsp;·&nbsp; Local Government Unit of Ginatilan</div>
    </div>

    <div class="auth-right">
        <div class="auth-card login-card-wrap">
            <div class="auth-card-header">
                <div class="auth-card-label">Municipality of Ginatilan</div>
                <div class="auth-card-title">Welcome Back!</div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div style="background:#fdecea;color:#c0392b;padding:10px 14px;border-radius:8px;font-size:13px;font-weight:600;margin-bottom:16px">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <div class="auth-form-group" style="margin-bottom:14px">
                    <label class="form-label">ID Number</label>
                    <input type="text" class="form-input" name="EmployeeID" placeholder="Enter your ID number" required />
                </div>
                <div class="auth-form-group" style="margin-bottom:4px">
                    <label class="form-label">Password</label>
                    <input type="password" class="form-input" name="Password" placeholder="Enter your password" required />
                </div>
                <a class="forgot-link">Forgot password?</a>
                <button type="submit" class="btn-primary" style="margin-top:18px">SIGN IN</button>
            </form>

            <div class="auth-switch-link">
                Don't have an account? <a asp-action="Register" asp-controller="Account">Register here</a>
            </div>
            <div class="auth-card-footer">Sign in with your assigned credentials</div>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <script>
        function showToast(msg, isError = false) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast' + (isError ? ' error' : '');
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2800);
        }
    </script>
</body>
</html>
