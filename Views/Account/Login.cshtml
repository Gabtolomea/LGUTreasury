@model LGUTreasury.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – LGU Revenue Record System</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --green: #1a7a2e;
            --green-dark: #145c22;
            --green-light: #e8f5eb;
            --accent: #f4c430;
            --text: #1a1a1a;
            --muted: #6b7280;
            --border: #d1d5db;
            --white: #ffffff;
            --input-bg: #f9fafb;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background-color: #f0f4f0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            display: flex;
            width: 900px;
            min-height: 560px;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }

        /* LEFT PANEL */
        .left-panel {
            background-color: var(--green);
            width: 42%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 36px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .left-panel::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            bottom: -80px;
            right: -80px;
        }

        .left-panel::after {
            content: '';
            position: absolute;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
            top: -60px;
            left: -60px;
        }

        .seal {
            width: 90px;
            height: 90px;
            margin-bottom: 24px;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,0.3);
            padding: 4px;
            background: rgba(255,255,255,0.1);
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            color: var(--white);
            line-height: 1.3;
            margin-bottom: 16px;
        }

        .brand-desc {
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            line-height: 1.7;
        }

        .footer-text {
            position: absolute;
            bottom: 20px;
            font-size: 11px;
            color: rgba(255,255,255,0.5);
        }

        /* RIGHT PANEL */
        .right-panel {
            background-color: var(--white);
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px 44px;
        }

        .form-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            color: var(--text);
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 6px;
        }

        input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            font-family: 'DM Sans', sans-serif;
            background: var(--input-bg);
            color: var(--text);
            transition: border-color 0.2s;
            outline: none;
        }

        input:focus {
            border-color: var(--green);
            background: var(--white);
        }

        .forgot-link {
            display: block;
            text-align: right;
            font-size: 12px;
            color: var(--green);
            text-decoration: none;
            margin-top: -12px;
            margin-bottom: 24px;
        }

        .forgot-link:hover { text-decoration: underline; }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background-color: var(--green);
            color: var(--white);
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            transition: background-color 0.2s;
            letter-spacing: 0.02em;
        }

        .btn-submit:hover { background-color: var(--green-dark); }

        .register-link {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: var(--muted);
        }

        .register-link a {
            color: var(--green);
            text-decoration: none;
            font-weight: 600;
        }

        .register-link a:hover { text-decoration: underline; }

        .validation-msg {
            color: #dc2626;
            font-size: 12px;
            margin-top: 4px;
        }

        .alert-danger {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 12px 16px;
            color: #dc2626;
            font-size: 13px;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Left Panel -->
        <div class="left-panel">
            <img src="~/images/lgu-seal.png" alt="LGU Seal" class="seal" onerror="this.style.display='none'" />
            <h1 class="brand-title">LGU Revenue Record System</h1>
            <p class="brand-desc">Secure, efficient revenue collection management for Local Government Units. Track payments, generate reports, and maintain full audit trails.</p>
            <span class="footer-text">Republic of the Philippines · Local Government Unit of Ginatilan</span>
        </div>

        <!-- Right Panel -->
        <div class="right-panel">
            <h2 class="form-title">Welcome!</h2>
            <p class="form-subtitle">Sign in with your assigned credentials.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger">
                    Invalid ID number or password. Please try again.
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="EmployeeID">ID Number</label>
                    <input type="text" id="EmployeeID" name="EmployeeID" placeholder="Enter your ID number" required />
                    <span class="validation-msg">@Html.ValidationMessage("EmployeeID")</span>
                </div>

                <div class="form-group">
                    <label for="Password">Password</label>
                    <input type="password" id="Password" name="Password" placeholder="Enter your password" required />
                    <span class="validation-msg">@Html.ValidationMessage("Password")</span>
                </div>

                <a href="#" class="forgot-link">Forgot password?</a>

                <button type="submit" class="btn-submit">SIGN IN</button>
            </form>

            <p class="register-link">
                Don't have an account? <a asp-action="Register" asp-controller="Account">Register here</a>
            </p>
        </div>
    </div>
</body>
</html>