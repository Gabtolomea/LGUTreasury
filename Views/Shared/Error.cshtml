@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="ui-error-page">
    <div class="ui-error-card">
        <div class="ui-error-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
        </div>

        <div class="ui-error-eyebrow">Error</div>
        <h1 class="ui-error-title">Something went wrong</h1>
        <p class="ui-error-message">
            We couldn't process your request. Please try again, or return to your workspace.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="ui-error-code">
                <span>Request ID</span>
                <code>@Model.RequestId</code>
            </div>
        }

        <div class="ui-error-actions">
            <button type="button" class="ui-error-btn" onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M13 8H3M3 8L7 4M3 8L7 12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Go Back
            </button>
            <a asp-controller="Home" asp-action="Index" class="ui-error-btn ui-error-btn--primary">
                Go to Workspace
            </a>
        </div>

        <details class="ui-error-details">
            <summary>Technical details</summary>
            <p>
                An unexpected error occurred while processing your request. If the problem continues,
                contact your system administrator@(Model.ShowRequestId ? " and include the request ID above." : ".").
            </p>
            <p>
                When running in the <strong>Development</strong> environment, more detailed information
                about the error is displayed. This should not be enabled for deployed applications
                because it can expose sensitive information.
            </p>
        </details>
    </div>
</div>
