@{
    ViewData["Title"] = "No Email Registered";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Admin — LGU Revenue Record System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { height: 100%; font-family: 'Inter', sans-serif; }
        :root {
            --green: #388E3C; --green-dark: #2E7D32; --green-light: #C8E6C9;
            --gray-input: #ebebeb; --gray-border: #E0E0E0;
            --text: #1a1a1a; --text-2: #444; --text-3: #888;
            --red: #c0392b; --shadow: 0 2px 12px rgba(0,0,0,.08);
        }
        body { display: flex; min-height: 100vh; }
        .btn-primary { width: 100%; padding: 14px; background: #388E3C; color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: 'Inter', sans-serif; transition: background .2s; letter-spacing: .04em; text-align: center; display: block; text-decoration: none; }
        .btn-primary:hover { background: #2E7D32; }
    </style>
</head>
<body>
    <div class="auth-left" style="width:42%">
        <img src="~/images/lgu.png" alt="LGU Logo" onerror="this.style.display='none'" />
        <div class="auth-left-title"><span>LGU</span> Revenue<br>Record System</div>
        <div class="auth-left-desc">Your account does not have a registered email address. Please contact your administrator for a password reset.</div>
        <div class="auth-left-footer">Republic of the Philippines &nbsp;·&nbsp; Local Government Unit of Ginatilan</div>
    </div>

    <div class="auth-right">
        <div class="auth-card login-card-wrap">
            <div class="auth-card-header">
                <div class="auth-card-label">Municipality of Ginatilan</div>
                <div class="auth-card-title">No Email Found</div>
            </div>

            <div style="background:#fff3e0;border:1px solid #FFE0B2;border-radius:10px;padding:16px;margin-bottom:20px">
                <div style="font-size:28px;margin-bottom:8px">📋</div>
                <div style="font-size:14px;font-weight:700;color:#E65100;margin-bottom:6px">No email address registered</div>
                <div style="font-size:13px;color:#BF360C">
                    @if (TempData["UserName"] != null)
                    {
                        <span>Hi <strong>@TempData["UserName"]</strong>, your</span>
                    }
                    else
                    {
                        <span>Your</span>
                    }
                    account does not have an email address on file. You cannot use the OTP reset flow.
                </div>
            </div>

            <p style="font-size:13px;color:var(--text-3);margin-bottom:20px">Please approach your system administrator and request a manual password reset. The admin can reset your password directly from the Admin panel.</p>

            <a asp-action="Login" asp-controller="Account" class="btn-primary">← Back to Sign In</a>

            <div class="auth-switch-link" style="margin-top:14px;font-size:12px;color:var(--text-3)">
                Once your admin resets your password, you can log in with your new credentials.
            </div>
        </div>
    </div>
</body>
</html>
