@using LGUTreasury.Models
@model IEnumerable<UserAccount>
@{
    ViewData["Title"] = "Manage Users";
    ViewData["ActiveNav"] = "manageusers";
}

<link rel="stylesheet" href="~/css/records.css" />

<style>
.user-status-active   { display:inline-block; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:700; background:var(--green-light); color:var(--green); }
.user-status-inactive { display:inline-block; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:700; background:#fdecea; color:var(--red); }
.action-toggle-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border: none; border-radius: 6px;
    cursor: pointer; margin-right: 3px; font-size: 12px; color: white;
    transition: background .15s;
}
.action-toggle-btn.deactivate { background: #e53935; }
.action-toggle-btn.deactivate:hover { background: #b71c1c; }
.action-toggle-btn.activate { background: var(--green); }
.action-toggle-btn.activate:hover { background: var(--green-dark); }
.password-wrap { position: relative; }
.password-wrap .form-input { padding-right: 44px; }
.password-toggle {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: none; padding: 4px; cursor: pointer;
    color: var(--text-3); display: flex; align-items: center; justify-content: center;
    transition: color .2s;
}
.password-toggle:hover { color: var(--text-2); }
.password-toggle svg { width: 18px; height: 18px; display: block; }
</style>

@Html.AntiForgeryToken()

<div class="records-page-wrap">
    <div class="page-header-row">
        <partial name="_BackBtn" />
        <div style="flex:1">
            <div class="page-title">Manage Users</div>
            <div class="page-sub">View, edit, activate or deactivate user accounts</div>
        </div>
    </div>

    <div class="records-toolbar">
        <div class="search-bar" style="flex:1">
            <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" placeholder="Search by name or ID…" oninput="filterUsers(this.value)" />
        </div>
    </div>

    <div class="data-table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Employee ID</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="users-tbody">
                @if (!Model.Any())
                {
                    <tr><td colspan="7" style="text-align:center;color:var(--text-3);padding:24px">No users found.</td></tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        var fullName = $"{user.LastName}, {user.FirstName}";
                        var isActive = user.Status == "Active";
                        <tr data-userid="@user.UserID" data-name="@fullName" data-email="@(user.Email ?? "")" data-contact="@(user.ContactNumber ?? "")" data-status="@user.Status">
                            <td style="font-weight:700;color:var(--green-dark)">@user.EmployeeID</td>
                            <td>@fullName</td>
                            <td>
                                <span style="display:inline-block;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;
                                    background:@(user.Role == "Admin" ? "#fdecea" : user.Role == "Officer" ? "#fff3e0" : "var(--green-light)");
                                    color:@(user.Role == "Admin" ? "var(--red)" : user.Role == "Officer" ? "var(--orange)" : "var(--green)")">
                                    @user.Role
                                </span>
                            </td>
                            <td style="color:var(--text-3)">
                                @if (string.IsNullOrEmpty(user.Email))
                                {
                                    <span style="color:#ccc;font-style:italic">No email</span>
                                }
                                else
                                {
                                    @user.Email
                                }
                            </td>
                            <td style="color:var(--text-3)">@(ContactNumberRules.Format(user.ContactNumber) ?? "—")</td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="user-status-active">Active</span>
                                }
                                else
                                {
                                    <span class="user-status-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                <button class="action-modify-btn" onclick="openEditUser(@user.UserID)" title="Edit Email / Contact">
                                    <span class="btn-icon">✎</span>
                                </button>
                                <button class="action-modify-btn" onclick="openResetPassword(@user.UserID, '@fullName')" title="Reset Password">
                                    <span class="btn-icon">🔑</span>
                                </button>
                                <button class="action-toggle-btn @(isActive ? "deactivate" : "activate")" onclick="toggleUserStatus(@user.UserID)" title="@(isActive ? "Deactivate Account" : "Activate Account")">
                                    <span>@(isActive ? "🔒" : "🔓")</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal-overlay" id="modal-reset-password">
    <div class="modal" style="max-width:420px">
        <div class="modal-title">Reset Password</div>
        <div class="modal-sub" id="modal-reset-sub">Set a new password for this user.</div>
        <input type="hidden" id="reset-user-id" />
        <div class="form-group" style="margin-bottom:10px;margin-top:14px">
            <label class="form-label">New Password</label>
            <div class="password-wrap">
                <input type="password" class="form-input" id="reset-new-password" placeholder="At least 6 characters" />
                <button type="button" class="password-toggle" data-target="reset-new-password" aria-label="Show password">
                    <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </div>
        <div class="form-group" style="margin-bottom:16px">
            <label class="form-label">Confirm Password</label>
            <div class="password-wrap">
                <input type="password" class="form-input" id="reset-confirm-password" placeholder="Re-enter new password" />
                <button type="button" class="password-toggle" data-target="reset-confirm-password" aria-label="Show password">
                    <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>
        </div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-reset-password')">Cancel</button>
            <button class="btn-primary" style="width:auto;padding:10px 22px;margin-top:0" onclick="submitResetPassword()">Reset Password</button>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal-overlay" id="modal-edit-user">
    <div class="modal" style="max-width:420px">
        <div class="modal-title">Edit User</div>
        <div class="modal-sub" id="modal-edit-user-sub">Update the email or contact number.</div>
        <input type="hidden" id="edit-user-id" />
        <div class="form-group" style="margin-bottom:10px;margin-top:14px">
            <label class="form-label">Email</label>
            <input type="email" class="form-input" id="edit-user-email" placeholder="name@example.com" />
        </div>
        <div class="form-group" style="margin-bottom:16px">
            <label class="form-label">Contact Number</label>
            <input type="text" class="form-input" id="edit-user-contact" placeholder="09XX-XXX-XXXX" />
        </div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-edit-user')">Cancel</button>
            <button class="btn-primary" style="width:auto;padding:10px 22px;margin-top:0" onclick="submitEditUser()">Save Changes</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    function initPasswordToggles() {
        document.querySelectorAll('.password-toggle').forEach(btn => {
            const input = document.getElementById(btn.getAttribute('data-target'));
            if (!input) return;
            btn.addEventListener('click', () => {
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                const eyeOpen = btn.querySelector('.eye-open');
                const eyeOff  = btn.querySelector('.eye-off');
                if (eyeOpen) eyeOpen.style.display = showing ? '' : 'none';
                if (eyeOff)  eyeOff.style.display  = showing ? 'none' : '';
                btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
            });
        });
    }

    function resetPasswordVisibility() {
        document.querySelectorAll('#modal-reset-password .password-toggle').forEach(btn => {
            const input = document.getElementById(btn.getAttribute('data-target'));
            if (input) input.type = 'password';
            const eyeOpen = btn.querySelector('.eye-open');
            const eyeOff  = btn.querySelector('.eye-off');
            if (eyeOpen) eyeOpen.style.display = '';
            if (eyeOff)  eyeOff.style.display  = 'none';
            btn.setAttribute('aria-label', 'Show password');
        });
    }

    initPasswordToggles();

    function filterUsers(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('#users-tbody tr').forEach(tr => {
            tr.style.display = tr.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }

    function getRow(userID) {
        return document.querySelector(`#users-tbody tr[data-userid="${userID}"]`);
    }

    function openEditUser(userID) {
        const row = getRow(userID);
        if (!row) return;
        document.getElementById('edit-user-id').value      = userID;
        document.getElementById('edit-user-email').value   = row.dataset.email || '';
        document.getElementById('edit-user-contact').value = row.dataset.contact || '';
        document.getElementById('modal-edit-user-sub').textContent = `Update the email or contact number for ${row.dataset.name}.`;
        openModal('modal-edit-user');
    }

    async function submitEditUser() {
        const userID        = document.getElementById('edit-user-id').value;
        const email         = document.getElementById('edit-user-email').value.trim();
        const contactNumber = document.getElementById('edit-user-contact').value.trim();

        if (email && !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
            showToast('Please enter a valid email address.', true);
            return;
        }

        const res  = await fetch('/Admin/UpdateUserContact', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: new URLSearchParams({ userID, email, contactNumber })
        });
        const data = await res.json();

        if (data.success) {
            closeModal('modal-edit-user');
            showToast('User details updated successfully.');
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(data.message || 'Failed to update user details.', true);
        }
    }

    async function toggleUserStatus(userID) {
        const row = getRow(userID);
        if (!row) return;
        const isActive = row.dataset.status === 'Active';
        const name     = row.dataset.name;

        const ok = await UI.confirm(
            isActive
                ? `Deactivate ${name}? They will no longer be able to sign in.`
                : `Activate ${name}? They will be able to sign in again.`,
            {
                title: isActive ? 'Deactivate Account' : 'Activate Account',
                type: isActive ? 'warning' : 'info',
                confirmText: isActive ? 'Deactivate' : 'Activate',
                cancelText: 'Cancel',
                danger: isActive
            }
        );
        if (!ok) return;

        const res  = await fetch('/Admin/ToggleUserStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: new URLSearchParams({ userID })
        });
        const data = await res.json();

        if (data.success) {
            showToast(isActive ? 'Account deactivated.' : 'Account activated.');
            setTimeout(() => location.reload(), 800);
        } else {
            showToast(data.message || 'Failed to update account status.', true);
        }
    }

    function openResetPassword(userID, fullName) {
        document.getElementById('reset-user-id').value = userID;
        document.getElementById('modal-reset-sub').textContent = `Set a new password for ${fullName}.`;
        document.getElementById('reset-new-password').value    = '';
        document.getElementById('reset-confirm-password').value = '';
        resetPasswordVisibility();
        openModal('modal-reset-password');
    }

    async function submitResetPassword() {
        const userID      = document.getElementById('reset-user-id').value;
        const newPassword = document.getElementById('reset-new-password').value;
        const confirm     = document.getElementById('reset-confirm-password').value;

        if (!newPassword || newPassword.length < 6) {
            showToast('Password must be at least 6 characters.', true);
            return;
        }
        if (newPassword !== confirm) {
            showToast('Passwords do not match.', true);
            return;
        }

        const res  = await fetch('/Admin/ResetPassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: new URLSearchParams({ userID, newPassword })
        });
        const data = await res.json();

        closeModal('modal-reset-password');
        if (data.success) showToast('Password reset successfully.');
        else showToast(data.message, true);
    }
</script>
}
