@using LGUTreasury.Models
@model IEnumerable<PaymentRecord>
@{
    ViewData["Title"] = "Records";
    ViewData["ActiveNav"] = "records";
    var role = ViewData["Role"]?.ToString();
    var isOfficerOrAdmin = role == "Officer" || role == "Admin";
    var isCollector = role == "Collector";
}

<link rel="stylesheet" href="~/css/records.css" />

@Html.AntiForgeryToken()

@if (TempData["Toast"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            showToast('@TempData["Toast"]');
        });
    </script>
}

<div class="records-page-wrap">
    <div class="page-header-row">
        <a asp-controller="Home" asp-action="Index" class="back-btn">←</a>
        <div style="flex:1">
            <div class="page-title" id="page-title-text">Payment Records</div>
            <div class="page-sub" id="page-sub-text">View and manage all payment records</div>
        </div>
    </div>

    <!-- Tab Switcher -->
    <div class="records-tabs">
        <button class="records-tab active" id="tab-records" onclick="switchTab('records')">
            <svg width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 2h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5"/><path d="M5 6h6M5 9h6M5 12h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Payment Records
        </button>
        @if (isCollector)
        {
            <button class="records-tab" id="tab-collection" onclick="switchTab('collection')">
                <svg width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M2 8h12M8 2v12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                For Collection
                <span class="tab-badge" id="collection-badge" style="background:var(--blue)">0</span>
            </button>
        }
        @if (isOfficerOrAdmin)
        {
            <button class="records-tab" id="tab-requests" onclick="switchTab('requests')">
                <svg width="14" height="14" fill="none" viewBox="0 0 16 16"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Modification Requests
                <span class="tab-badge" id="tab-badge">0</span>
            </button>
        }
    </div>

    <!-- RECORDS PANEL -->
    <div id="panel-records">
        <div class="records-toolbar">
            <div class="search-bar" style="flex:1">
                <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
                <input type="text" placeholder="Search by name, receipt, or type…" oninput="filterRecords(this.value)" />
            </div>
        </div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Transaction ID</th>
                        <th>Payor</th>
                        <th>Collection Type</th>
                        <th>Total Amount</th>
                        <th>Date Issued</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="records-tbody">
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" style="text-align:center;color:var(--text-3);padding:24px">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var record in Model)
                        {
                            var txnID    = "TXN-" + record.PaymentID.ToString("D6");
                            var payee    = record.Payee != null ? $"{record.Payee.Lastname}, {record.Payee.Firstname}" : "—";
                            var type     = record.RecordLineItems?.FirstOrDefault()?.RevenueType?.Name ?? "—";
                            var amount   = record.TotalAmount.ToString("N2");
                            var date     = record.DateIssued.ToString("MMM dd, yyyy");
                            var orNumber = record.OfficialReceipt ?? "—";
                            var method   = record.PaymentMethod ?? "—";
                            var remarks  = record.Remarks ?? "";

                            // Status logic
                            string status;
                            string statusClass;
                            if (record.HasPendingRequest) { status = "Pending"; statusClass = "pending"; }
                            else if (record.IsCollected)  { status = "Collected"; statusClass = "collected"; }
                            else                          { status = "Posted"; statusClass = "posted"; }

                            <tr>
                                <td style="font-weight:700;color:var(--green-dark)">@txnID</td>
                                <td>@payee</td>
                                <td>@type</td>
                                <td style="font-weight:600">₱ @amount</td>
                                <td style="color:var(--text-3)">@date</td>
                                <td><span class="status-text-@statusClass">@status</span></td>
                                <td style="white-space:nowrap">
                                    <button class="action-view-btn"
                                            onclick="viewRecord('@txnID','@payee','@type','@amount','@date','@orNumber','@status','@method','@remarks')"
                                            title="View">
                                        <span class="btn-icon">
                                            <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><circle cx="5" cy="5" r="2" fill="white"/><path d="M1 5s1.5-3 4-3 4 3 4 3-1.5 3-4 3-4-3-4-3Z" stroke="white" stroke-width="1"/></svg>
                                        </span>
                                    </button>
                                    @if (isCollector && !record.HasPendingRequest)
                                    {
                                        <button class="action-modify-btn" onclick="openModifyRequest(@record.PaymentID, '@txnID')" title="Request Modification">
                                            <span class="btn-icon">✎</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- FOR COLLECTION PANEL — Collector only -->
    @if (isCollector)
    {
        <div id="panel-collection" style="display:none">
            <div class="records-toolbar">
                <div class="search-bar" style="flex:1">
                    <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <input type="text" placeholder="Search by name or receipt…" oninput="filterCollection(this.value)" />
                </div>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Payor</th>
                            <th>Collection Type</th>
                            <th>Total Amount</th>
                            <th>Date Issued</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="collection-tbody">
                        @{
                            var uncollected = Model.Where(r => !r.IsCollected && !r.HasPendingRequest).ToList();
                        }
                        @if (!uncollected.Any())
                        {
                            <tr><td colspan="6" style="text-align:center;color:var(--text-3);padding:24px">No pending collections.</td></tr>
                        }
                        else
                        {
                            @foreach (var record in uncollected)
                            {
                                var txnID  = "TXN-" + record.PaymentID.ToString("D6");
                                var payee  = record.Payee != null ? $"{record.Payee.Lastname}, {record.Payee.Firstname}" : "—";
                                var type   = record.RecordLineItems?.FirstOrDefault()?.RevenueType?.Name ?? "—";
                                var amount = record.TotalAmount.ToString("N2");
                                var date   = record.DateIssued.ToString("MMM dd, yyyy");

                                <tr data-paymentid="@record.PaymentID">
                                    <td style="font-weight:700;color:var(--green-dark)">@txnID</td>
                                    <td>@payee</td>
                                    <td>@type</td>
                                    <td style="font-weight:600">₱ @amount</td>
                                    <td style="color:var(--text-3)">@date</td>
                                    <td>
                                        <button class="action-approve-btn" onclick="confirmCollection(@record.PaymentID)" title="Confirm Collection">
                                            <span class="btn-icon">✓</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- REQUESTS PANEL — Officer/Admin only -->
    @if (isOfficerOrAdmin)
    {
        <div id="panel-requests" style="display:none">
            <div class="records-toolbar">
                <div class="search-bar" style="flex:1">
                    <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
                    <input type="text" placeholder="Search by name, receipt…" oninput="filterApprove(this.value)" />
                </div>
            </div>
            <div class="data-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Transaction ID</th>
                            <th>Payor</th>
                            <th>Reason</th>
                            <th>Date</th>
                            <th>Requested By</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="approve-tbody">
                        @if (ViewBag.EditRequests == null || ((IEnumerable<EditRequest>)ViewBag.EditRequests).Count() == 0)
                        {
                            <tr><td colspan="8" style="text-align:center;color:var(--text-3);padding:24px">No modification requests found.</td></tr>
                        }
                        else
                        {
                            @foreach (var req in (IEnumerable<EditRequest>)ViewBag.EditRequests)
                            {
                                var txnID     = "TXN-" + req.PaymentID.ToString("D6");
                                var payee     = req.PaymentRecord?.Payee != null ? $"{req.PaymentRecord.Payee.Lastname}, {req.PaymentRecord.Payee.Firstname}" : "—";
                                var reqBy     = req.RequestedBy != null ? $"{req.RequestedBy.FirstName} {req.RequestedBy.LastName}" : "—";
                                var isPending = req.Status == "Pending";

                                <tr data-requestid="@req.RequestID">
                                    <td style="font-weight:700;color:var(--text-2)">REQ-@req.RequestID.ToString("D6")</td>
                                    <td style="font-weight:700;color:var(--green-dark)">@txnID</td>
                                    <td>@payee</td>
                                    <td>@(req.Reason ?? "—")</td>
                                    <td style="color:var(--text-3)">@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>@reqBy</td>
                                    <td><span class="request-status status-text-@req.Status.ToLower()">@req.Status</span></td>
                                    <td style="white-space:nowrap">
                                        @if (isPending)
                                        {
                                            <button class="action-approve-btn" onclick="openApprove(@req.RequestID)" title="Approve">
                                                <span class="btn-icon">✓</span>
                                            </button>
                                            <button class="action-reject-btn" onclick="openReject(@req.RequestID)" title="Reject">
                                                <span class="btn-icon">✕</span>
                                            </button>
                                        }
                                        <button class="action-view-btn" onclick="viewRequest(@req.RequestID, '@txnID', '@payee', '@(req.Reason ?? "")', '@req.CreatedAt.ToString("MMM dd, yyyy")', '@reqBy', '@req.Status', '@(req.ProposedOR ?? "")', '@(req.ProposedDate?.ToString("MMM dd, yyyy") ?? "")', '@(req.ProposedPaymentMethod ?? "")', '@(req.ProposedAmount?.ToString("N2") ?? "")', '@(req.ProposedRemarks ?? "")')" title="View">
                                            <span class="btn-icon">
                                                <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><circle cx="5" cy="5" r="2" fill="white"/><path d="M1 5s1.5-3 4-3 4 3 4 3-1.5 3-4 3-4-3-4-3Z" stroke="white" stroke-width="1"/></svg>
                                            </span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- View Record Modal -->
<div class="modal-overlay" id="modal-view-record">
    <div class="modal" style="max-width:500px">
        <div class="modal-title" id="modal-view-title">Payment Record</div>
        <div id="modal-record-content"></div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-view-record')">Close</button>
        </div>
    </div>
</div>

<!-- Request Modification Modal -->
<div class="modal-overlay" id="modal-modify-request">
    <div class="modal" style="max-width:500px;max-height:85vh;overflow-y:auto">
        <div class="modal-title">Request Modification</div>
        <div class="modal-sub" id="modal-modify-sub">Propose changes to this payment record.</div>
        <input type="hidden" id="modify-payment-id" />
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Reason for Modification *</label>
            <textarea class="form-input" id="modify-reason" placeholder="e.g. Wrong amount entered…" style="min-height:60px;width:100%;margin-top:4px"></textarea>
        </div>
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--green);margin:10px 0 6px;padding-bottom:4px;border-bottom:1.5px solid var(--green-light)">Proposed Changes</div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">OR Number</label>
            <input type="text" class="form-input" id="modify-or" placeholder="Proposed OR number" />
        </div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Date Issued</label>
            <input type="date" class="form-input" id="modify-date" />
        </div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Collection Type</label>
            <select class="form-select" id="modify-type">
                <option value="">-- No Change --</option>
                @if (ViewBag.RevenueTypes != null)
                {
                    foreach (var type in ViewBag.RevenueTypes)
                    {
                        <option value="@type.TypeID">@type.Name</option>
                    }
                }
            </select>
        </div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Payment Method</label>
            <select class="form-select" id="modify-method">
                <option value="">-- No Change --</option>
                <option value="Cash">Cash</option>
                <option value="Check">Check</option>
                <option value="Online Transfer">Online Transfer</option>
            </select>
        </div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Total Amount (₱)</label>
            <input type="number" class="form-input" id="modify-amount" placeholder="Proposed amount" step="0.01" />
        </div>
        <div class="form-group" style="margin-bottom:10px">
            <label class="form-label">Remarks</label>
            <textarea class="form-input" id="modify-remarks" placeholder="Optional remarks" style="min-height:50px;width:100%"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-modify-request')">Cancel</button>
            <button class="btn-primary" style="width:auto;padding:10px 22px;margin-top:0" onclick="submitModifyRequest()">Submit Request</button>
        </div>
    </div>
</div>

<!-- Confirm Approve Modal -->
<div class="modal-overlay" id="modal-confirm-approve">
    <div class="modal">
        <div class="modal-title">Approve Modification?</div>
        <div class="modal-sub">The proposed changes will be applied to the payment record.</div>
        <div id="approve-proposed-changes" style="margin-bottom:14px"></div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-confirm-approve')">Cancel</button>
            <button class="btn-primary" onclick="confirmApprove()">Yes, Approve</button>
        </div>
    </div>
</div>

<!-- Confirm Reject Modal -->
<div class="modal-overlay" id="modal-confirm-reject">
    <div class="modal">
        <div class="modal-title">Reject Modification?</div>
        <div class="modal-sub">Provide an optional reason for rejection.</div>
        <div style="margin-bottom:14px">
            <label class="form-label">Reason (optional)</label>
            <textarea class="form-input" id="reject-reason" placeholder="e.g. Incorrect amount entered" style="min-height:80px;width:100%;margin-top:6px"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-confirm-reject')">Cancel</button>
            <button style="padding:10px 20px;background:var(--red);border:none;border-radius:8px;font-size:13px;font-weight:700;color:white;cursor:pointer;font-family:inherit" onclick="confirmReject()">Reject</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/records.js"></script>
}
