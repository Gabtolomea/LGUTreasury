@model List<LGUTreasury.Models.PaymentRecord>

@{
    ViewData["Title"] = "Records";
    ViewData["ActiveNav"] = "records";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .records-page-wrap { padding: 0 16px 32px; }
    .records-toolbar {
        display: flex; gap: 10px; align-items: center;
        padding: 16px 0;
    }
    .search-bar {
        display: flex; align-items: center;
        background: white; border: 1px solid var(--gray-border);
        border-radius: 24px; padding: 9px 16px;
        gap: 8px; box-shadow: var(--shadow); flex: 1;
    }
    .search-bar input {
        border: none; outline: none;
        font-size: 13.5px; font-family: inherit;
        color: var(--text); background: transparent; flex: 1;
    }
    .btn-add-record {
        display: flex; align-items: center; gap: 6px;
        background: var(--green); color: white;
        border: none; border-radius: 8px;
        padding: 10px 16px; font-size: 13px;
        font-weight: 600; cursor: pointer;
        font-family: inherit; text-decoration: none;
        white-space: nowrap;
    }
    .btn-add-record:hover { background: var(--green-dark); }
    .data-table-wrap {
        background: white; border-radius: 12px;
        border: 1px solid var(--gray-border);
        box-shadow: var(--shadow); overflow: hidden;
    }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .data-table th {
        padding: 13px 16px; text-align: left;
        font-size: 11.5px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .05em;
        color: var(--text-3);
        border-bottom: 2px solid var(--gray-border);
    }
    .data-table td {
        padding: 13px 16px; border-bottom: 1px solid #f5f5f5;
        color: var(--text); vertical-align: middle;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #fafafa; }
    .receipt-no { font-weight: 600; color: var(--green-dark); }
    .amount { font-weight: 600; }
    .date { color: var(--text-3); }
</style>

<div class="records-page-wrap">
    <div class="records-toolbar">
        <div class="search-bar">
            <svg width="16" height="16" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" placeholder="Search payments, names, or receipts.." id="search-input" oninput="filterTable()" />
        </div>
        <a asp-controller="Record" asp-action="Create" class="btn-add-record">+ Record Payment</a>
    </div>

    <div class="data-table-wrap">
        <table class="data-table" id="records-table">
            <thead>
                <tr>
                    <th>Receipt No.</th>
                    <th>Payor</th>
                    <th>Total Amount</th>
                    <th>Date Issued</th>
                    <th>Collected By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var record in Model)
                    {
                        <tr>
                            <td class="receipt-no">@record.OfficialReceipt</td>
                            <td>@record.Payee?.Lastname, @record.Payee?.Firstname @record.Payee?.Middlename</td>
                            <td class="amount">₱ @record.TotalAmount.ToString("N2")</td>
                            <td class="date">@record.DateIssued.ToString("MMM dd, yyyy")</td>
                            <td>@record.CollectedBy?.FirstName @record.CollectedBy?.LastName</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:40px;color:var(--text-3)">No records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterTable() {
        const query = document.getElementById('search-input').value.toLowerCase();
        const rows = document.querySelectorAll('#records-table tbody tr');
        rows.forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
        });
    }
</script>
}