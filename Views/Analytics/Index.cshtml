@{
    ViewData["Title"] = "Analytics";
    ViewData["ActiveNav"] = "analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .analytics-page { padding:0 24px 32px; }
    .page-header-row { display:flex; align-items:center; gap:12px; padding:18px 0 14px; }
    .page-title { font-size:20px; font-weight:700; color:var(--text); }
    .page-sub { font-size:13px; color:var(--green); }

    /* Filter Bar */
    .filter-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
    .custom-range { display:flex; align-items:center; gap:6px; }
    .custom-range input { padding:7px 10px; background:white; border:1.5px solid var(--gray-border); border-radius:8px; font-size:12px; font-family:inherit; outline:none; }
    .custom-range input:focus { border-color:var(--green); }
    .btn-apply { padding:7px 14px; background:var(--green); color:white; border:none; border-radius:8px; font-size:12px; font-weight:700; font-family:inherit; cursor:pointer; }
    .btn-apply:hover { background:var(--green-dark); }

    /* Summary Widgets */
    .summary-head-row { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; }
    .summary-heading { font-size:15px; font-weight:800; color:var(--text); }
    .summary-period {
        font-size:11px; font-weight:700; color:var(--green);
        background:var(--green-light); padding:4px 12px; border-radius:999px;
    }
    .summary-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:24px; }
    .summary-card {
        --accent:#388E3C; --accent-soft:#E8F5E9;
        position:relative; background:white; border-radius:14px;
        border:1px solid var(--gray-border); box-shadow:var(--shadow);
        padding:16px 18px 14px; overflow:hidden;
        display:flex; flex-direction:column;
        transition:transform .2s, box-shadow .2s, border-color .2s;
    }
    .summary-card::before {
        content:''; position:absolute; top:0; left:0; bottom:0;
        width:4px; background:var(--accent); opacity:.85;
    }
    .summary-card::after {
        content:''; position:absolute; right:-30px; top:-30px;
        width:92px; height:92px; border-radius:50%;
        background:var(--accent-soft); opacity:.55; pointer-events:none;
    }
    .summary-card:hover { transform:translateY(-3px); box-shadow:0 10px 26px rgba(0,0,0,.10); border-color:var(--accent-soft); }
    .summary-top { display:flex; align-items:center; gap:10px; margin-bottom:12px; position:relative; z-index:1; }
    .summary-icon {
        width:36px; height:36px; border-radius:10px; flex-shrink:0;
        display:flex; align-items:center; justify-content:center;
        background:var(--accent-soft); color:var(--accent);
    }
    .summary-icon svg { width:18px; height:18px; }
    .summary-title { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--text-3); }
    .summary-current { font-size:23px; font-weight:800; color:var(--text); letter-spacing:-.02em; position:relative; z-index:1; }
    .summary-foot {
        display:flex; align-items:center; gap:8px;
        margin-top:auto; padding-top:10px; border-top:1px dashed #ececec;
        font-size:11px; font-weight:500; color:var(--text-3);
        position:relative; z-index:1;
    }
    .trend { display:inline-flex; align-items:center; gap:3px; font-weight:700; font-size:11px; padding:2px 8px; border-radius:999px; }
    .trend-up { background:#E8F5E9; color:#2E7D32; }
    .trend-down { background:#FDECEA; color:#C0392B; }
    .trend-flat { background:#f2f2f2; color:#888; }
    .accent-blue { --accent:#2980B9; --accent-soft:#E3F2FD; }
    .accent-purple { --accent:#7B2D8B; --accent-soft:#F3E5F5; }
    .accent-green { --accent:#388E3C; --accent-soft:#E8F5E9; }
    @@media (max-width:1100px) { .summary-row { grid-template-columns:1fr; } }

    /* Section */
    .chart-section { margin-bottom:28px; }
    .section-title { font-size:15px; font-weight:700; color:var(--text); margin-bottom:12px; padding-bottom:8px; border-bottom:2px solid var(--green-light); display:flex; align-items:center; gap:8px; }
    .section-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }

    /* Chart Cards */
    .charts-grid { display:grid; grid-template-columns:2fr 1fr; gap:14px; }
    .chart-card { background:white; border-radius:12px; border:1px solid var(--gray-border); box-shadow:var(--shadow); padding:16px 20px; }
    .chart-card-title { font-size:12px; font-weight:700; color:var(--text-2); margin-bottom:12px; text-transform:uppercase; letter-spacing:.04em; }
    .chart-wrap { position:relative; }
    .chart-wrap.bar  { height:220px; }
    .chart-wrap.pie  { height:220px; }

    /* No data */
    .no-data { display:flex; align-items:center; justify-content:center; height:220px; color:var(--text-3); font-size:13px; flex-direction:column; gap:6px; }
</style>

<div class="analytics-page">
    <div class="page-header-row">
        <div>
            <div class="page-title">Revenue Analytics</div>
            <div class="page-sub">View revenue across periods and sources</div>
        </div>
    </div>

    <!-- FILTER BAR — Custom Range only -->
    <div class="filter-bar">
        <div class="custom-range">
            <input type="date" id="custom-from" />
            <span style="color:var(--text-3);font-size:12px">to</span>
            <input type="date" id="custom-to" />
            <button class="btn-apply" onclick="applyCustom()">Apply</button>
        </div>
    </div>

    <!-- SUMMARY WIDGETS -->
    <div class="summary-head-row">
        <div class="summary-heading">Overview</div>
        <div class="summary-period" id="period-label">This Month</div>
    </div>
    <div class="summary-row">
        <div class="summary-card accent-blue">
            <div class="summary-top">
                <div class="summary-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>
                </div>
                <div class="summary-title">One-Time Payments</div>
            </div>
            <div class="summary-current" id="sum-onetime-current">₱ 0.00</div>
            <div class="summary-foot">
                <span class="trend trend-flat" id="sum-onetime-delta">—</span>
                <span>vs previous period</span>
            </div>
        </div>
        <div class="summary-card accent-purple">
            <div class="summary-top">
                <div class="summary-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
                </div>
                <div class="summary-title">Long Term Payments</div>
            </div>
            <div class="summary-current" id="sum-longterm-current">₱ 0.00</div>
            <div class="summary-foot">
                <span class="trend trend-flat" id="sum-longterm-delta">—</span>
                <span>vs previous period</span>
            </div>
        </div>
        <div class="summary-card accent-green">
            <div class="summary-top">
                <div class="summary-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>
                </div>
                <div class="summary-title">Combined Received Payments</div>
            </div>
            <div class="summary-current" id="sum-combined-current">₱ 0.00</div>
            <div class="summary-foot">
                <span class="trend trend-flat" id="sum-combined-delta">—</span>
                <span>vs previous period</span>
            </div>
        </div>
    </div>

    <!-- ONE-TIME PAYMENTS SECTION -->
    <div class="chart-section">
        <div class="section-title">
            <div class="section-dot" style="background:var(--blue)"></div>
            One-Time Payments: by Revenue Type
        </div>
        <div class="charts-grid">
            <div class="chart-card">
                <div class="chart-card-title">Collection by Revenue Type</div>
                <div class="chart-wrap bar"><canvas id="chart-onetime-bar"></canvas></div>
            </div>
            <div class="chart-card">
                <div class="chart-card-title">Revenue Type Distribution</div>
                <div class="chart-wrap pie"><canvas id="chart-onetime-pie"></canvas></div>
            </div>
        </div>
    </div>

    <!-- LONG TERM BILLS SECTION -->
    <div class="chart-section">
        <div class="section-title">
            <div class="section-dot" style="background:#7b2d8b"></div>
            Long Term Tenant Bills: by Billing Type
        </div>
        <div class="charts-grid">
            <div class="chart-card">
                <div class="chart-card-title">Collection by Billing Type</div>
                <div class="chart-wrap bar"><canvas id="chart-longterm-bar"></canvas></div>
            </div>
            <div class="chart-card">
                <div class="chart-card-title">Billing Type Distribution</div>
                <div class="chart-wrap pie"><canvas id="chart-longterm-pie"></canvas></div>
            </div>
        </div>
    </div>

    <!-- COMBINED SECTION -->
    <div class="chart-section">
        <div class="section-title">
            <div class="section-dot" style="background:var(--green)"></div>
            Combined Revenue: One-Time vs Long Term
        </div>
        <div class="charts-grid">
            <div class="chart-card">
                <div class="chart-card-title">Revenue by Source</div>
                <div class="chart-wrap bar"><canvas id="chart-combined-bar"></canvas></div>
            </div>
            <div class="chart-card">
                <div class="chart-card-title">Revenue Source Distribution</div>
                <div class="chart-wrap pie"><canvas id="chart-combined-pie"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script>
Chart.register(ChartDataLabels);
let charts = {};

const COLORS = {
    current: '#388E3C',
    currentBg: 'rgba(56,142,60,0.8)',
    pie: ['#388E3C','#2196F3','#FF9800','#9C27B0','#F44336','#009688','#FF5722','#3F51B5','#CDDC39','#00BCD4']
};

function applyCustom() {
    const from = document.getElementById('custom-from').value;
    const to   = document.getElementById('custom-to').value;
    if (!from || !to) { showToast('Please select a date range.', true); return; }
    if (from > to)    { showToast('From date cannot be after To date.', true); return; }
    loadData();
}

async function loadData() {
    const from = document.getElementById('custom-from').value;
    const to   = document.getElementById('custom-to').value;
    if (!from || !to) return;

    try {
        const res  = await fetch(`/Analytics/GetData?filter=custom&from=${from}&to=${to}`);
        const data = await res.json();
        renderAll(data);
    } catch (err) { showToast('Error loading analytics data.', true); }
}

function fmt(val) {
    return '₱ ' + parseFloat(val).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function setDelta(id, current, compare) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!compare) {
        el.textContent = '—';
        el.className = 'trend trend-flat';
        return;
    }
    const pct = ((current - compare) / compare) * 100;
    const up = pct >= 0;
    el.textContent = (up ? '▲ ' : '▼ ') + Math.abs(pct).toFixed(1) + '%';
    el.className = 'trend ' + (up ? 'trend-up' : 'trend-down');
}

function renderAll(data) {
    // Summary widgets — current period only
    document.getElementById('sum-onetime-current').textContent  = fmt(data.oneTime.totalCurrent);
    document.getElementById('sum-longterm-current').textContent = fmt(data.longTerm.totalCurrent);
    document.getElementById('sum-combined-current').textContent = fmt(data.combined.totalCurrent);

    document.getElementById('period-label').textContent = data.labels.current;
    setDelta('sum-onetime-delta',  data.oneTime.totalCurrent,  data.oneTime.totalCompare);
    setDelta('sum-longterm-delta', data.longTerm.totalCurrent, data.longTerm.totalCompare);
    setDelta('sum-combined-delta', data.combined.totalCurrent, data.combined.totalCompare);

    // Charts — single dataset (current only)
    renderBarChart('chart-onetime-bar',  data.oneTime.labels,   data.oneTime.current);
    renderPieChart('chart-onetime-pie',  data.oneTime.pieLabels, data.oneTime.pieCurrent);
    renderBarChart('chart-longterm-bar', data.longTerm.labels,  data.longTerm.current);
    renderPieChart('chart-longterm-pie', data.longTerm.pieLabels, data.longTerm.pieCurrent);
    renderBarChart('chart-combined-bar', data.combined.labels,  data.combined.current);
    renderPieChart('chart-combined-pie', data.combined.labels,  data.combined.current);
}

function renderBarChart(id, labels, values) {
    if (charts[id]) charts[id].destroy();
    const ctx = document.getElementById(id)?.getContext('2d');
    if (!ctx) return;

    charts[id] = new Chart(ctx, {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                data: values,
                backgroundColor: COLORS.currentBg,
                borderColor: COLORS.current,
                borderWidth: 1.5,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ` ₱ ${parseFloat(ctx.raw).toLocaleString('en-PH', { minimumFractionDigits: 2 })}`
                    }
                },
                datalabels: {
                    anchor: 'center',
                    align: 'center',
                    color: 'white',
                    font: { size: 15, weight: '700', family: 'Inter' },
                    formatter: v => v > 0 ? '₱ ' + parseFloat(v).toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) : '',
                    display: ctx => ctx.dataset.data[ctx.dataIndex] > 0
                }
            },
            scales: {
                x: { grid: { display: false }, ticks: { font: { size: 11, family: 'Inter' } } },
                y: {
                    grid: { color: '#f0f0f0' },
                    ticks: {
                        font: { size: 11, family: 'Inter' },
                        callback: v => '₱ ' + v.toLocaleString('en-PH')
                    }
                }
            }
        }
    });
}

function renderPieChart(id, labels, data) {
    if (charts[id]) charts[id].destroy();
    const ctx = document.getElementById(id)?.getContext('2d');
    if (!ctx) return;

    const total = data.reduce((a, b) => a + b, 0);
    if (total === 0) return;

    charts[id] = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels,
            datasets: [{
                data,
                backgroundColor: COLORS.pie.slice(0, labels.length),
                borderWidth: 2,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                datalabels: { display: false },
                legend: { position: 'bottom', labels: { font: { size: 11, family: 'Inter' }, boxWidth: 12, padding: 8 } },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const pct = (ctx.raw / total * 100).toFixed(1);
                            return ` ${ctx.label}: ₱ ${parseFloat(ctx.raw).toLocaleString('en-PH', { minimumFractionDigits: 2 })} (${pct}%)`;
                        }
                    }
                }
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    // Default to current month
    const now   = new Date();
    const y     = now.getFullYear();
    const m     = String(now.getMonth() + 1).padStart(2, '0');
    const d     = String(now.getDate()).padStart(2, '0');
    const first = `${y}-${m}-01`;
    const today = `${y}-${m}-${d}`;
    document.getElementById('custom-from').value = first;
    document.getElementById('custom-to').value   = today;
    loadData();
});
</script>
}
