@{
    ViewData["Title"] = "Generate Report";
    ViewData["ActiveNav"] = "report";
}

<link rel="stylesheet" href="~/css/generate-report.css" />

<div class="report-page-wrap">
    <div class="page-header-row">
        <a asp-controller="Home" asp-action="Index" class="back-btn">←</a>
        <div>
            <div class="page-title">Revenue Summaries</div>
            <div class="page-sub">Export revenue summaries and collection data</div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-title">Report Parameters</div>
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Report Type</label>
                <select class="form-select" id="report-type">
                    <option value="daily">Daily Collection Report</option>
                    <option value="weekly">Weekly Revenue Summary</option>
                    <option value="monthly">Monthly Revenue Summary</option>
                    <option value="annual">Annual Revenue Summary</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">File Format</label>
                <select class="form-select" id="report-format">
                    <option value="pdf">PDF</option>
                    <option value="xlsx">Excel (XLSX)</option>
                    <option value="csv">CSV</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" class="form-input" id="report-from" />
            </div>
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" class="form-input" id="report-to" />
            </div>
        </div>
        <div class="generate-actions" style="margin-top:16px">
            <button class="btn-generate" onclick="generateReport()">GENERATE &amp; DOWNLOAD</button>
        </div>
    </div>

    <div class="form-section">
        <div class="section-title">Recently Generated</div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Report Name</th>
                        <th>Type</th>
                        <th>Generated By</th>
                        <th>Date</th>
                        <th>Format</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="reports-tbody">
                    @if (ViewBag.RecentReports == null || ViewBag.RecentReports.Count == 0)
                    {
                        <tr><td colspan="6" style="text-align:center;color:var(--text-3);padding:24px">No reports generated yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function generateReport() {
            const type   = document.getElementById('report-type').value;
            const format = document.getElementById('report-format').value;
            const from   = document.getElementById('report-from').value;
            const to     = document.getElementById('report-to').value;

            if (!from || !to) {
                showToast('Please select a date range.', true);
                return;
            }
            if (from > to) {
                showToast('From date cannot be after To date.', true);
                return;
            }

            showToast('Generating report...');
            window.location.href = '/Report/Generate?type=' + type + '&format=' + format + '&from=' + from + '&to=' + to;
        }
    </script>
}
