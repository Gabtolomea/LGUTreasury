@{
    ViewData["Title"] = "Generate Report";
    ViewData["ActiveNav"] = "report";
}

<link rel="stylesheet" href="~/css/generate-report.css" />

<div class="report-page-wrap">
    <div class="page-header-row">
        <a asp-controller="Home" asp-action="Index" class="back-btn">←</a>
        <div>
            <div class="page-title">Revenue Summaries</div>
            <div class="page-sub">Export revenue summaries and collection data</div>
        </div>
    </div>

    <div class="form-section">
        <div class="section-title">Report Parameters</div>
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Report Type</label>
                <select class="form-select" id="report-type">
                    <option value="daily">Daily Collection Report</option>
                    <option value="weekly">Weekly Revenue Summary</option>
                    <option value="monthly">Monthly Revenue Summary</option>
                    <option value="annual">Annual Revenue Summary</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">File Format</label>
                <select class="form-select" id="report-format">
                    <option value="pdf">PDF</option>
                    <option value="xlsx">Excel (XLSX)</option>
                    <option value="csv">CSV</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" class="form-input" id="report-from" />
            </div>
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" class="form-input" id="report-to" />
            </div>
        </div>
        <div class="generate-actions" style="margin-top:16px">
            <button class="btn-generate" onclick="generateReport()">GENERATE &amp; DOWNLOAD</button>
        </div>
    </div>

    <div class="form-section">
        <div class="section-title">Recently Generated</div>
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Report Name</th>
                        <th>Type</th>
                        <th>Generated By</th>
                        <th>Date</th>
                        <th>Format</th>
                        <th></th>
                    </tr>
                </thead>
                 <tbody id="reports-tbody">
                   @if (ViewBag.RecentReports == null || ViewBag.RecentReports.Count == 0)
    {
        <tr><td colspan="6" style="text-align:center;color:var(--text-3);padding:24px">No reports generated yet.</td></tr>
    }
    else
    {
        foreach (var report in ViewBag.RecentReports)
        {
            <tr>
                <td>@report.ReportType</td>
                <td>@report.ReportType</td>
                <td>@ViewData["FullName"]</td>
                <td>@report.GeneratedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                <td>@report.Format</td>
                <td>
                    <div class="action-btns">
                        <button class="icon-btn" title="Download" onclick="showToast('Downloading...')">
                            <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><path d="M8 2v8M5 7l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                        </button>
                    </div>
                </td>
            </tr>
        }
    }
</tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fmtDate(d) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        // Determine the report type that matches a given date range
        function detectReportType(from, to) {
            const f = new Date(from + 'T00:00:00');
            const t = new Date(to + 'T00:00:00');
            if (isNaN(f) || isNaN(t) || f > t) return null;

            const span = Math.round((t - f) / 86400000) + 1;
            const sameYear = f.getFullYear() === t.getFullYear();
            const sameMonth = sameYear && f.getMonth() === t.getMonth();
            const isFullYear = sameYear && f.getMonth() === 0 && f.getDate() === 1 &&
                               t.getMonth() === 11 && t.getDate() === 31;

            if (span === 1) return 'daily';
            if (isFullYear) return 'annual';
            if (sameMonth && span > 7) return 'monthly';
            if (span === 7) return 'weekly';
            if (sameMonth) return 'monthly';
            return null;
        }

        // Sync the Report Type dropdown whenever the date range changes
        function syncTypeFromDates() {
            const from = document.getElementById('report-from').value;
            const to = document.getElementById('report-to').value;
            if (!from || !to) return;
            const type = detectReportType(from, to);
            if (type) document.getElementById('report-type').value = type;
        }

        // Sync the date range whenever the Report Type changes
        function syncDatesFromType() {
            const type = document.getElementById('report-type').value;
            const fromEl = document.getElementById('report-from');
            const toEl = document.getElementById('report-to');
            const now = new Date();
            let start = new Date(now);
            let end = new Date(now);

            if (type === 'daily') {
                start = new Date(now);
                end = new Date(now);
            } else if (type === 'weekly') {
                start = new Date(now);
                start.setDate(start.getDate() - 6);
                end = new Date(now);
            } else if (type === 'monthly') {
                start = new Date(now.getFullYear(), now.getMonth(), 1);
                end = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            } else if (type === 'annual') {
                start = new Date(now.getFullYear(), 0, 1);
                end = new Date(now.getFullYear(), 11, 31);
            }

            fromEl.value = fmtDate(start);
            toEl.value = fmtDate(end);
        }

        function generateReport() {
            const type   = document.getElementById('report-type').value;
            const format = document.getElementById('report-format').value;
            const from   = document.getElementById('report-from').value;
            const to     = document.getElementById('report-to').value;

            if (!from || !to) {
                showToast('Please select a date range.', true);
                return;
            }
            if (from > to) {
                showToast('From date cannot be after To date.', true);
                return;
            }

            showToast('Generating report...');
            window.location.href = '/Report/Generate?type=' + type + '&format=' + format + '&from=' + from + '&to=' + to;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            const fromEl = document.getElementById('report-from');
            const toEl = document.getElementById('report-to');
            fromEl.max = today;
            toEl.max = today;

            fromEl.addEventListener('change', syncTypeFromDates);
            toEl.addEventListener('change', syncTypeFromDates);
            document.getElementById('report-type').addEventListener('change', syncDatesFromType);

            // Default the page to the current month (Monthly)
            if (!fromEl.value && !toEl.value) {
                syncDatesFromType();
            }
        });
    </script>
}
