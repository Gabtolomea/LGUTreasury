@using LGUTreasury.Models
@model IEnumerable<RevenueType>
@{
    ViewData["Title"] = "Revenue Types";
    ViewData["ActiveNav"] = "revtype";
}

<link rel="stylesheet" href="~/css/revenue-type.css" />

@Html.AntiForgeryToken()

<div class="revenue-page-wrap">
    <div class="page-header-row">
        <div>
            <div class="page-title">Revenue Types</div>
            <div class="page-sub">Manage collection categories and base rates</div>
        </div>
    </div>

    <div class="records-toolbar">
        <div class="search-bar" style="flex:1">
            <svg width="15" height="15" fill="none" viewBox="0 0 16 16"><circle cx="7" cy="7" r="5" stroke="#aaa" stroke-width="1.5"/><path d="M11 11l3 3" stroke="#aaa" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" placeholder="Search revenue types…" oninput="filterRevTypes(this.value)" />
        </div>
    </div>

    <div class="data-table-wrap">
        <div class="rt-section-title">Revenue Types</div>
        <table class="data-table" id="revtype-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Revenue Type</th>
                    <th>Category</th>
                    <th>Base Amount</th>
                    <th>Surcharge (%)</th>
                    <th>Interest (%)</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="revtype-tbody">
                @foreach (var type in Model)
                {
                    var policy = type.RevenuePolicies?.FirstOrDefault();
                    <tr data-typeid="@type.TypeID"
                        data-name="@type.Name"
                        data-categoryid="@type.CategoryID"
                        data-baserate="@type.BaseRate"
                        data-surcharge="@(policy?.SurchargeRate ?? 0)"
                        data-interest="@(policy?.InterestRate ?? 0)">
                        <td style="font-weight:700;color:var(--green-dark)">#@type.TypeID.ToString("D3")</td>
                        <td>@type.Name</td>
                        <td>@type.CategoryID</td>
                        <td>₱ @type.BaseRate.ToString("N2")</td>
                        <td>@(policy?.SurchargeRate ?? 0)%</td>
                        <td>@(policy?.InterestRate ?? 0)%</td>
                        <td>
                            <button class="action-edit-btn" onclick="editRevType(this)" title="Edit">
                                <span class="btn-icon-rev">
                                    <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M1 9l1.5-1.5 5-5L9 4 4 9H1Z" stroke="white" stroke-width="1" stroke-linejoin="round"/><path d="M6.5 2.5l1 1" stroke="white" stroke-width="1" stroke-linecap="round"/></svg>
                                </span>
                            </button>
                        </td>
                        <td>
                            <button class="action-remove-btn" onclick="removeRevType(this)" title="Remove">
                                <span class="btn-icon-rev">
                                    <svg width="10" height="10" fill="none" viewBox="0 0 10 10"><path d="M1.5 3h7M4 3V2h2v1M2.5 3l.5 6h4l.5-6" stroke="white" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 5v2.5M6 5v2.5" stroke="white" stroke-width="1" stroke-linecap="round"/></svg>
                                </span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="revtype-add-row">
                    <td>—</td>
                    <td><input type="text" class="add-row-input" id="add-rt-name" placeholder="New revenue type name…" /></td>
                    <td>
                        <select class="add-row-select" id="add-rt-category">
                            @foreach (var cat in ViewBag.Categories)
                            {
                                <option value="@cat.CategoryID">@cat.CategoryID</option>
                            }
                        </select>
                    </td>
                    <td><input type="number" class="add-row-input" id="add-rt-rate" placeholder="0.00" step="0.01" /></td>
                    <td><input type="number" class="add-row-input" id="add-rt-surcharge" placeholder="0" /></td>
                    <td><input type="number" class="add-row-input" id="add-rt-interest" placeholder="0" /></td>
                    <td colspan="2"><button class="add-row-btn" onclick="addRevTypeInline()">+ Add</button></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Edit Revenue Type Modal -->
<div class="modal-overlay" id="modal-revtype">
    <div class="modal">
        <div class="modal-title" id="modal-revtype-title">Edit Revenue Type</div>
        <div class="modal-sub">Update the details for this revenue type.</div>

        <div class="form-group">
            <label class="form-label">Revenue Type Name</label>
            <input type="text" class="form-input" id="rt-name" placeholder="e.g. Building Permit" />
        </div>
        <div class="form-group">
            <label class="form-label">Category</label>
            <select class="form-select" id="rt-category">
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat.CategoryID">@cat.CategoryID — @cat.Name</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Base Rate (₱)</label>
            <input type="number" class="form-input" id="rt-rate" placeholder="0.00" step="0.01" oninput="computePreview()" />
        </div>
        <div class="form-group">
            <label class="form-label">Surcharge (%)</label>
            <input type="number" class="form-input" id="rt-surcharge" placeholder="0" oninput="computePreview()" />
        </div>
        <div class="form-group">
            <label class="form-label">Interest (%)</label>
            <input type="number" class="form-input" id="rt-interest" placeholder="0" oninput="computePreview()" />
        </div>

        <!-- Live Computation Preview -->
        <div style="background:var(--green-light);border-radius:10px;padding:12px 16px;margin-top:4px;margin-bottom:4px">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--green-dark);margin-bottom:8px">Computed Breakdown</div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px">
                <span style="color:var(--text-2)">Base Amount</span>
                <span id="preview-base" style="font-weight:600">₱ 0.00</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px">
                <span style="color:var(--text-2)">Surcharge Amount</span>
                <span id="preview-surcharge" style="font-weight:600">₱ 0.00</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px;margin-bottom:8px">
                <span style="color:var(--text-2)">Interest Amount</span>
                <span id="preview-interest" style="font-weight:600">₱ 0.00</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:14px;border-top:1px solid var(--green-mid);padding-top:8px">
                <span style="font-weight:700;color:var(--text)">Total</span>
                <span id="preview-total" style="font-weight:800;color:var(--green-dark)">₱ 0.00</span>
            </div>
        </div>

        <div class="modal-actions">
            <button class="btn-secondary" onclick="closeModal('modal-revtype')">Cancel</button>
            <button class="btn-primary" onclick="saveRevType()">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/revenue-type.js"></script>
}
